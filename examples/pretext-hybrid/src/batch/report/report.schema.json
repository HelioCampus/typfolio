{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgressReportInput",
  "description": "Runtime input of ./main.typ; keep in step with ../data.ts. Used only to build the editor sample.",
  "type": "object",
  "required": ["number", "student", "term", "courses", "attendance", "comment"],
  "properties": {
    "number": { "type": "integer", "minimum": 1 },
    "student": {
      "type": "object",
      "required": ["name", "studentId", "programme"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "studentId": { "type": "string", "minLength": 1 },
        "programme": { "type": "string" }
      }
    },
    "term": { "type": "string" },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "title", "score", "grade"],
        "properties": {
          "code": { "type": "string" },
          "title": { "type": "string" },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "grade": { "type": "string" }
        }
      }
    },
    "attendance": { "type": "integer", "minimum": 0, "maximum": 100 },
    "comment": { "type": "string" }
  }
}
