{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "Outcome results"
      ]
    },
    "generatedAt": {
      "type": "string",
      "examples": [
        "18 October 2026"
      ]
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The level names, the columns of the results table.",
      "examples": [
        [
          "Exemplary",
          "Proficient"
        ]
      ]
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "Written communication"
            ]
          },
          "students": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "description": "Students per level, in the order of levels.",
            "examples": [
              [
                9,
                12
              ]
            ]
          },
          "summary": {
            "type": "string",
            "examples": [
              "21 of 30 students reached Proficient or above."
            ]
          },
          "chart": {
            "type": "string",
            "contentMediaType": "image/svg+xml",
            "description": "Path render() returned, such as /charts/0.svg."
          },
          "chartAlt": {
            "type": "string",
            "examples": [
              "Bar chart of students per level."
            ]
          }
        },
        "required": [
          "name",
          "students",
          "summary",
          "chart",
          "chartAlt"
        ]
      }
    }
  },
  "required": [
    "title",
    "generatedAt",
    "levels",
    "outcomes"
  ]
}
