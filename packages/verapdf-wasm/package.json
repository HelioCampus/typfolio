{
  "name": "@typfolio/verapdf-wasm",
  "version": "0.1.0",
  "description": "veraPDF's PDF/A and PDF/UA validator built to WebAssembly with GraalVM Web Image, for Node and browsers",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelioCampus/typfolio.git",
    "directory": "packages/verapdf-wasm"
  },
  "homepage": "https://github.com/HelioCampus/typfolio#readme",
  "bugs": { "url": "https://github.com/HelioCampus/typfolio/issues" },
  "files": ["dist", "generated", "java", "LICENSE", "LICENSE-APACHE", "README.md", "CHANGELOG.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
