{
  "name": "@typfolio/paramdoc",
  "version": "0.0.1",
  "description": "Experimental: fills a parametric document exported from a Typst template with data and writes tagged PDF/UA-1, without a compiler, in a few hundred microseconds; dependency-free, for browsers, workers and Node",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["typst", "pdf", "pdf-ua", "accessibility", "template", "browser", "web-worker", "paramdoc"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelioCampus/typfolio.git",
    "directory": "packages/paramdoc"
  },
  "homepage": "https://github.com/HelioCampus/typfolio#readme",
  "bugs": { "url": "https://github.com/HelioCampus/typfolio/issues" },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": { "node": ">=22" },
  "sideEffects": false
}
