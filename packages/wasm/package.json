  "keywords": ["typst", "pdf", "pdf-ua", "accessibility", "wasm", "webassembly", "browser"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelioCampus/typfolio.git",
    "directory": "packages/wasm"
  },
  "homepage": "https://github.com/HelioCampus/typfolio#readme",
  "bugs": { "url": "https://github.com/HelioCampus/typfolio/issues" },
  "files": ["generated", "NOTICE", "THIRD_PARTY_NOTICES.md", "THIRD_PARTY_LICENSES.md", "README.md"],
