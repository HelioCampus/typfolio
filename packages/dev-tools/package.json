{
  "name": "@typfolio/dev-tools",
  "version": "0.1.0",
  "description": "Dev-time tools for Typfolio templates: schema-based template checks and PDF inspection (install as a devDependency)",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["typst", "pdf", "pdf-ua", "accessibility", "template", "testing", "ci", "json-schema"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelioCampus/typfolio.git",
    "directory": "packages/dev-tools"
  },
  "homepage": "https://github.com/HelioCampus/typfolio#readme",
  "bugs": { "url": "https://github.com/HelioCampus/typfolio/issues" },
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./pdf": { "types": "./dist/pdf.d.ts", "import": "./dist/pdf.js" }
  },
  "dependencies": {
    "@typfolio/core": "^0.1.0"
  },
  "peerDependencies": {
    "pdfjs-dist": "^6.3.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": { "node": ">=22" },
  "sideEffects": false
}
